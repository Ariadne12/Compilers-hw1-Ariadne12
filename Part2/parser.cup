/**
 *  Package and Import Specifications
 */
import java_cup.runtime.*;

/**
 *  Usercode Components
 */
parser code {:
    // Connect this parser to a scanner!
    Scanner s;
    Parser(Scanner s){ this.s=s; }
:}

/* define how to connect to the scanner! */
scan with {: return s.next_token(); :};

/**
 *  Symbol Lists
 */

/* Terminals (tokens returned by the scanner). */
terminal            IF, ELSE, PREFIX, SUFFIX;
terminal            CONCAT, LPAREN, RPAREN, RPAREN_LBRACE, RBRACE, COMMA;
terminal String     ID, STRING_LITERAL;

/*  Non terminals */
non terminal String program, functions, function_definition;
non terminal String statements, expr, function_call, cond;
non terminal String params, params_list, args, args_list;

/**
 *  Precedence Declarations
 */
precedence right IF;
precedence left PREFIX, SUFFIX;
precedence left CONCAT;

/**
 *  The Grammar Rules
 */
program ::= functions:f statements:s                    
        {: RESULT = 
            "public class Main {\n" + 
            "public static void main(String[] args) {\n" + 
            s +
            "}\n\n" +
            f +
            "}\n";

            System.out.println(RESULT);
        :}
;

functions ::= functions:f function_definition:fd        {: RESULT = fd + "\n" + f; :}
           | /* empty */                                {: RESULT = ""; :}
;

function_definition ::= ID:id LPAREN params:p RPAREN_LBRACE expr:e RBRACE
                {: 
                        
                        RESULT = "public static String " + id + "(" + p + ") {\nreturn " + e + ";\n}\n"; 
                :}
;

params ::= params_list:pl                               {: RESULT = pl; :}
        | /* empty */                                   {: RESULT = ""; :}
;

params_list ::= ID:id                                   {: RESULT = "String " + id; :}
            | params_list:pl COMMA ID:id                {: RESULT = pl + ", String " + id; :}
;

expr ::= STRING_LITERAL:s                               {: RESULT = "\"" + s + "\""; :}
        | ID:id                                         {: RESULT = id; :}
        | expr:e1 CONCAT expr:e2                        {: RESULT = e1 + " + " + e2; :}
        | IF LPAREN cond:c RPAREN expr:e1 ELSE expr:e2  {: RESULT = "(" + "(" + c + ")" + "?" + e1 + ":" + e2 + ")"; :}
        | function_call:fc                              {: RESULT = fc; :}
;

cond ::= expr:e1 SUFFIX expr:e2                         {: RESULT = e2 + ".endsWith(" + e1 + ")"; :}
        | expr:e1 PREFIX expr:e2                        {: RESULT = e2 + ".startsWith(" + e1 + ")"; :}
;

statements ::= expr:e statements:s                      {: RESULT = "System.out.println(" + e + ");\n" + s; :}
            | /* empty */                               {: RESULT = ""; :}
;

function_call ::= ID:id LPAREN args:a RPAREN            {: RESULT = id + "(" + a + ")"; :}
;

args ::= args_list:al                                   {: RESULT = al; :}
        | /* empty */                                   {: RESULT = ""; :}
;

args_list ::= expr:e                                    {: RESULT = e; :}
            | args_list:al COMMA expr:e                 {: RESULT = al + ", " + e; :}
;