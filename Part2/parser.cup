/**
 *  Package and Import Specifications
 */
import java_cup.runtime.*;

/**
 *  Usercode Components
 */
parser code {:
    // Connect this parser to a scanner!
    Scanner s;
    Parser(Scanner s){ this.s=s; }
:}

/* define how to connect to the scanner! */
scan with {: return s.next_token(); :};

/**
 *  Symbol Lists
 */

/* Terminals (tokens returned by the scanner). */
terminal            IF, ELSE, PREFIX, SUFFIX;
terminal            CONCAT, LPAREN, RPAREN, RPAREN_LBRACE, RBRACE, COMMA;
terminal String     ID, STRING_LITERAL;

/*  Non terminals */
non terminal String program, functions, function_definition;
non terminal String statements, expr, function_call, cond;
non terminal String args, args_list;
non terminal String red_expr, red_cond, red_args, red_args_list, tl_function_call;

/**
 *  Precedence Declarations
 */
precedence right IF;
precedence left PREFIX, SUFFIX;
precedence left CONCAT;

/**
 *  The Grammar Rules
 */
program ::= functions:f statements:s                    
        {: RESULT = 
            "public class Main {\n" + 
            "public static void main(String[] args) {\n" + 
            s +
            "}\n\n" +
            f +
            "}\n";

            System.out.println(RESULT);
        :}
;

functions ::= functions:f function_definition:fd        {: RESULT = f + fd + "\n"; :}
           | /* empty */                                {: RESULT = ""; :}
;

function_definition ::= ID:id LPAREN args:a RPAREN_LBRACE expr:e RBRACE
                {: 
                        if (a.contains("(") || a.contains("\"")) {
                                throw new Exception("Error: only identifiers allowed parameters in declaration of '" + id + "'");
                        }
                        String params = (a.isEmpty()) ? "" : "String " + a.replaceAll("\\s*,\\s*", ", String ");
                        RESULT = "public static String " + id + "(" + params + ") {\nreturn " + e + ";\n}\n"; 
                :}
;

args ::= args_list:al                                   {: RESULT = al; :}
        | /* empty */                                   {: RESULT = ""; :}
;

args_list ::= expr:e                                    {: RESULT = e; :}
            | args_list:al COMMA expr:e                 {: RESULT = al + ", " + e; :}
;

expr ::= STRING_LITERAL:s                               {: RESULT = "\"" + s + "\""; :}
        | ID:id                                         {: RESULT = id; :}
        | expr:e1 CONCAT expr:e2                        {: RESULT = e1 + " + " + e2; :}
        | IF LPAREN cond:c RPAREN expr:e1 ELSE expr:e2  {: RESULT = "(" + "(" + c + ")" + "?" + e1 + ":" + e2 + ")"; :}
        | function_call:fc                              {: RESULT = fc; :}
;

cond ::= expr:e1 SUFFIX expr:e2                         {: RESULT = e2 + ".endsWith(" + e1 + ")"; :}
        | expr:e1 PREFIX expr:e2                        {: RESULT = e2 + ".startsWith(" + e1 + ")"; :}
;

function_call ::= ID:id LPAREN args:a RPAREN            {: RESULT = id + "(" + a + ")"; :}
;

/*reduced expression, no ID */
red_expr ::= STRING_LITERAL:s                               {: RESULT = "\"" + s + "\""; :}
        | red_expr:e1 CONCAT red_expr:e2                        {: RESULT = e1 + " + " + e2; :}
        | IF LPAREN red_cond:c RPAREN red_expr:e1 ELSE red_expr:e2  {: RESULT = "(" + "(" + c + ")" + "?" + e1 + ":" + e2 + ")"; :}
        | tl_function_call:fc                              {: RESULT = fc; :}
;

red_cond ::= red_expr:e1 SUFFIX red_expr:e2                {: RESULT = "(" +  e2  + ")" + ".endsWith(" + e1 + ")"; :} 
        | red_expr:e1 PREFIX red_expr:e2                {: RESULT = "(" + e2 + ")"  + ".startsWith(" + e1 + ")"; :}
;

statements ::= red_expr:e statements:s                      {: RESULT = "System.out.println(" + e + ");\n" + s; :}
            | /* empty */                               {: RESULT = ""; :}
;

red_args ::= red_args_list:al                                   {: RESULT = al; :}
        | /* empty */                                   {: RESULT = ""; :}
;

red_args_list ::= red_expr:e                                    {: RESULT = e; :}
                | red_args_list:al COMMA red_expr:e                 {: RESULT = al + ", " + e; :}
;

/*top level fc */
tl_function_call ::= ID:id LPAREN red_args:a RPAREN            {: RESULT = id + "(" + a + ")"; :}
;